{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "rasa-restaurant-os",
  "main": "./server/worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "rasa_restaurant_os_db",
      "database_name": "rasa-restaurant-os-db",
      "database_id": "0011aad9-4ddf-4628-9a35-4f3311012195"
    }
  ],
  "observability": {
    "enabled": true
  }
}
