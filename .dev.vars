# Variabel lokal untuk `wrangler dev` (TIDAK dipakai di produksi).
# OTP_SCREEN_FALLBACK=1 -> kode OTP boleh dikembalikan ke klien pada
# pengembangan lokal sehingga skrip uji (.uji-*.ps1) tetap berjalan
# tanpa layanan email. Produksi: hapus/ kosongkan, OTP selalu dikirim
# ke email (RESEND_API_KEY harus dipasang lewat `wrangler secret put`).
OTP_SCREEN_FALLBACK=1
